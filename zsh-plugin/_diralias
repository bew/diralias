#compdef diralias

local -a commands
commands=(
  'add:Create an alias NAME pointing to PATH'
  'remove:Remove an alias NAME'
  'rename:Rename an alias OLD to NEW, keeping its target'
  'retarget:Change the target of an existing alias NAME'
  'get:Get the alias name for PATH (default: current directory)'
  'list:List aliases as NAME=PATH pairs (machine-readable)'
  'status:List all aliases and current change-tick (human-readable)'
  'path:Print paths to internal state files/dirs'
  'help:Show usage information'
  'version:Show version'
)

local -a path_subcommands
path_subcommands=(
  'tick-file:Print path to the change-tick file'
  'aliases-dir:Print path to the aliases directory'
)

_diralias_alias_names() {
  local -a names
  local line
  while IFS='=' read -r name _; do
    names+=("$name")
  done < <(diralias list --include-broken 2>/dev/null)
  compadd -a names
}

_arguments -C \
  '(-h --help)'{-h,--help}'[Show usage information]' \
  '(-v --version)'{-v,--version}'[Show version]' \
  '1:command:->command' \
  '*:args:->args' \
  && return

case "$state" in
  command)
    _describe 'command' commands
    ;;
  args)
    case "${words[2]}" in
      add)
        case $((CURRENT - 2)) in
          1) _message 'alias name' ;;
          2) _directories ;;
        esac
        ;;
      remove|rm)
        case $((CURRENT - 2)) in
          1) _diralias_alias_names ;;
        esac
        ;;
      rename)
        case $((CURRENT - 2)) in
          1) _diralias_alias_names ;;
          2) _message 'new alias name' ;;
        esac
        ;;
      retarget)
        case $((CURRENT - 2)) in
          1) _diralias_alias_names ;;
          2) _directories ;;
        esac
        ;;
      get)
        _directories
        ;;
      list)
        _arguments '--include-broken[Include aliases with missing targets]'
        ;;
      path)
        _describe 'sub-command' path_subcommands
        ;;
    esac
    ;;
esac
